# ==============================================================================
# WeatherFlow Environment Configuration
# ==============================================================================

# Database Connection URL:
# -------------------------
# Default (SQLite - zero local setup needed, ideal for immediate local testing):
DATABASE_URL=sqlite:///data/weatherflow.db

# PostgreSQL (uncomment and configure when PostgreSQL is running):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/weatherflow

# NOAA API Configuration (Optional):
# -----------------------------------
# Request a free token at: https://www.ncdc.noaa.gov/cdo-web/token
# If left blank, WeatherFlow automatically runs in local sample CSV mode.
NOAA_TOKEN=

# Pipeline Execution Settings:
# ----------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
